# HTTP server (Render sets PORT; local dev uses AGENT_GATEWAY_PORT)
AGENT_GATEWAY_HOST=0.0.0.0
AGENT_GATEWAY_PORT=8081
RUST_LOG=info,aquachain_agent_gateway=debug

# x402 on Base Sepolia testnet (chain id 84532) - not Base mainnet
# Gas ETH: Alchemy Base Sepolia faucet or Base docs faucet list (no mainnet ETH needed)
# Test USDC: Coinbase CDP portal faucet preferred; Circle may require mainnet ETH dust
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PAYTO_ADDRESS=
X402_NETWORK=base-sepolia
X402_ASSET=USDC
X402_ASSET_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_PRICE_USDC=0.01
AGENT_GATEWAY_PUBLIC_URL=http://localhost:8081

# Osmosis relayer (G1: signs submit_data to citizen-science-registry)
RELAYER_MNEMONIC=
OSMOSIS_RPC=https://rpc.osmotest5.osmosis.zone
OSMOSIS_CHAIN_ID=osmo-test-5
OSMOSIS_DENOM=uosmo
CSR_CONTRACT_ADDRESS=osmo1s2a2f6je78ga2atc3rzq76lmzs9kane9h9fa3w62rjvcw5mk5lvsyxwtm4

# Dev only: accept POST without x402 payment (never enable in production)
X402_DEV_BYPASS=false
